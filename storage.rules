rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isImageUpload() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // 只用於 create／update：request.resource.name 是不含 bucket 的完整物件路徑字串。
    // {allPaths=**} 是 Path 型別，沒有 matches()／size()，string(path) 也不支援（2026-10-22 T-015 emulator 實測）。
    function isSecondaryIdentityUpload() {
      return request.resource.name.matches('(?s)images/users/[^/]+/identities/secondary/.*');
    }

    // 讀取只開 get（公開顯示圖片）；list 一律關閉，前台沒有列舉需求（取代原 allow read 含 list，2026-11-13 健檢 A3-01）。
    match /images/users/{uid}/identities/secondary/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isImageUpload();
      // 正式部署版（2026-03-06）任何路徑都刪不掉；A 清除頭像走 commitSecondaryIdentityAvatar，不用用戶端刪除。
      // 開放本人刪除屬放寬，需站長授權（T-015 取代 5d3afd302 的「本人可刪」）。
      allow delete: if false;
    }

    match /images/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      // 兩站上傳檔名都帶時間戳、每次都是新物件，用戶端不需要覆寫既有圖片
      // （取代原「登入即可 create, update」，2026-11-13 健檢 A3-01）。
      // 上傳到已存在的物件在 emulator 實測走 create 而不是 update，所以要用 resource == null 擋覆寫；
      // update（只改 metadata）一併關閉。
      allow create: if request.auth != null
        && resource == null
        && !isSecondaryIdentityUpload()
        && isImageUpload();
      allow update: if false;
      allow delete: if false;
    }
  }
}
