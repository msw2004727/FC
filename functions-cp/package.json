{
    "name": "toosterx-functions-cp",
    "private": true,
    "type": "module",
    "engines": {
        "node": "22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "bench": "vitest bench --run",
        "manifest:write": "node scripts/engine-manifest.mjs --write",
        "manifest:check": "node scripts/engine-manifest.mjs --check",
        "test:rules:unit": "vitest run -c vitest.rules.config.ts",
        "test:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore --project demo-cp-rules \"npm run test:rules:unit\"",
        "test:emu:unit": "vitest run -c vitest.emu.config.ts",
        "test:emu": "firebase emulators:exec --config firebase.rules-test.json --only firestore --project demo-cp-rules \"npm run test:emu:unit\""
    },
    "devDependencies": {
        "@types/node": "^22",
        "firebase": "^10.14.1",
        "firebase-tools": "^14.27.0",
        "typescript": "^5.6",
        "vitest": "^2.1"
    },
    "dependencies": {
        "firebase-admin": "^13.10.0",
        "firebase-functions": "^7.2.5"
    },
    "main": "lib/index.js"
}
